# ════════════════════════════════════════════════════════════════
# Rsaga TRPG bot — 环境变量配置示例
# 复制为 .env 并填入你自己的 key。所有接口均 OpenAI 兼容，可换任意服务商。
# ════════════════════════════════════════════════════════════════

# ── 鉴权（单用户静态 token，手机首次进入输入）──
BOT_TOKEN=change-me-to-a-random-string

# ── LLM 大脑（对话核心）任意 OpenAI 兼容服务 ──
# 最省 token：DeepSeek（缓存命中 ¥0.1/百万token）；也可用 Kimi/GLM/本地 Ollama/llama.cpp 等
QWEN_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=your-deepseek-or-other-key
QWEN_MODEL=deepseek-chat

# ── 画面总结模型（把回复总结成绘图 prompt，轻量即可）──
# 默认复用 STEP；也可单独配成 DeepSeek 等更省
SUMMARY_BASE_URL=https://api.stepfun.com/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=step-1-8k

# ── ASR 语音转文字（OpenAI Whisper 兼容 /audio/transcriptions）──
STEP_BASE=https://api.stepfun.com/v1
STEP_API_KEY=your-step-key
ASR_MODEL=stepaudio-2.5-asr

# ── TTS 文字转语音（OpenAI 兼容 /audio/speech）──
TTS_MODEL=stepaudio-2.5-tts
TTS_VOICE=your-voice-id
TTS_INSTRUCTION=用剧中角色的语气朗读对白，带感情，语调有起伏，情绪饱满，像真人在说话

# ── 背景图生成（OpenAI 兼容 /images/generations）──
IMG_MODEL=step-2x-large
IMG_SIZE=256x256

# ── LLM 输出上限 ──
LLM_MAX_TOKENS=1000
